# Firebase Client SDK Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=demo-api-key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=pathshala-school-saas.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=pathshala-school-saas
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=pathshala-school-saas.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
NEXT_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Firebase Emulator toggle (set to true to connect to local emulators)
NEXT_PUBLIC_USE_FIREBASE_EMULATOR=false

# App URLs
NEXT_PUBLIC_APP_URL=http://localhost:3000
